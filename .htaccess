# Lottie Animation Exporter - Apache Configuration

# PHP-Einstellungen
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value memory_limit 256M
php_value max_execution_time 300

# Sicherheit - Verzeichnis-Listen deaktivieren
Options -Indexes

# Schutz für Upload- und Export-Verzeichnisse
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Nur direkte PHP-Datei-Anfragen an Verzeichnisse blockieren
    RewriteCond %{REQUEST_URI} ^/(uploads|exports)/ [NC]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [F,L]
</IfModule>

# Cache-Control für statische Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# Kompression aktivieren
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>
